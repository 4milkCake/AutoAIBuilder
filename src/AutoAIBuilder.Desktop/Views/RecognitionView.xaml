<UserControl x:Class="AutoAIBuilder.Desktop.Views.RecognitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AutoAIBuilder.Desktop.Controls"
             AutomationProperties.Name="Reconhecimento supervisionado de novo DWG">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16,13"
                Background="#0D1D30"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Marco 11.6I — Reconhecimento supervisionado"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Leia um DWG novo, compare símbolos com a base validada e revise cada candidato. O original nunca é gravado."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,6"
                        Background="#102641"
                        BorderBrush="{Binding RecognitionStageAccent}"
                        BorderThickness="1"
                        CornerRadius="14"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding RecognitionStage}"
                               Foreground="{Binding RecognitionStageAccent}"
                               FontSize="9"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="315" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="14"
                            Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Novo DWG"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <TextBox Margin="0,9,0,0"
                                     Text="{Binding RecognitionSourcePath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     ToolTip="{Binding RecognitionSourcePath}" />
                            <Button Margin="0,8,0,0"
                                    Content="Escolher DWG"
                                    Command="{Binding ChooseRecognitionDwgCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button Margin="0,8,0,0"
                                    Content="{Binding RecognitionAnalyzeButtonText}"
                                    Command="{Binding AnalyzeRecognitionCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                            <StackPanel Margin="0,9,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding RecognitionRunningVisibility}">
                                <ProgressBar Width="72"
                                             Height="4"
                                             IsIndeterminate="True" />
                                <TextBlock Margin="8,0,0,0"
                                           Text="AutoCAD somente leitura…"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="8" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding RecognitionSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="#63B8FF"
                                       FontSize="8" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="14"
                            Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Medição"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <Border Margin="0,0,5,5"
                                        Padding="9"
                                        Background="#102641"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecognitionCandidateCount}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Candidatos"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="5,0,0,5"
                                        Padding="9"
                                        Background="#102641"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecognitionHighConfidenceCount}"
                                                   Foreground="#63B8FF"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Alta confiança"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,5,5,0"
                                        Padding="9"
                                        Background="#102641"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecognitionNeedsReviewCount}"
                                                   Foreground="#F8C33A"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Revisar"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="5,5,0,0"
                                        Padding="9"
                                        Background="#102641"
                                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecognitionReviewedCount}"
                                                   Foreground="#36D17C"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Revisados"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding RecognitionInventorySummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding RecognitionIntegrity}"
                                       TextWrapping="Wrap"
                                       Foreground="#36D17C"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding RecognitionProfileSource}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <Button Margin="0,10,0,0"
                                    Content="Abrir pasta da análise"
                                    Command="{Binding OpenRecognitionRunCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="14"
                            Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Legenda do projeto"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding RecognitionLegendStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding RecognitionLegendAccent}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding RecognitionLegendSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <Expander Margin="0,9,0,0"
                                      Header="Dicionário símbolo → descrição"
                                      IsExpanded="True">
                                <ListBox Margin="0,7,0,0"
                                         MaxHeight="285"
                                         ItemsSource="{Binding RecognitionLegendEntries}"
                                         Background="#091523"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,5">
                                                <TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           Foreground="#DCE6F4"
                                                           FontSize="8"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding BlockName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Evidence}"
                                                           Foreground="#63B8FF"
                                                           FontSize="7" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding Origin}"
                                                           ToolTip="{Binding StablePath}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="7" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                            <TextBlock Margin="0,7,0,0"
                                       Text="Os exemplares da legenda não entram na fila de pontos da planta."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="7" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*"
                                   MinHeight="250" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="0.6*"
                                   MinHeight="135" />
                </Grid.RowDefinitions>

                <Border Padding="8"
                        Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="5,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,2,0,0"
                                       Text="DWG e candidatos detectados"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Width="27"
                                        Height="23"
                                        Padding="0"
                                        Content="−"
                                        Click="CadZoomOut_Click"
                                        ToolTip="Reduzir zoom"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Width="27"
                                        Height="23"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        Content="+"
                                        Click="CadZoomIn_Click"
                                        ToolTip="Ampliar"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Height="23"
                                        Margin="4,0,0,0"
                                        Padding="8,0"
                                        Content="Ajustar"
                                        Click="CadFit_Click"
                                        ToolTip="Ajustar à área dos candidatos"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Height="23"
                                        Margin="4,0,0,0"
                                        Padding="8,0"
                                        Content="Tudo"
                                        Click="CadFitAll_Click"
                                        ToolTip="Mostrar todo o model space"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Height="23"
                                        Margin="4,0,0,0"
                                        Padding="10,0"
                                        Content="Expandir"
                                        Click="CadExpand_Click"
                                        ToolTip="Abrir o DWG e a fila em uma janela maximizada"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <controls:CadViewportControl x:Name="CadViewport"
                                                     Grid.Row="1"
                                                     Snapshot="{Binding RecognitionCadSnapshot}"
                                                     OverlayPoints="{Binding RecognitionOverlayPoints}"
                                                     Layers="{Binding RecognitionCadLayers}"
                                                     SelectedPointId="{Binding SelectedRecognitionPointId}"
                                                     SelectPointCommand="{Binding SelectRecognitionOverlayPointCommand}"
                                                     OverlayPointSelected="CadViewport_OverlayPointSelected"
                                                     FitAllByDefault="True"
                                                     ClipToBounds="True"
                                                     Focusable="True"
                                                     ToolTip="Roda do mouse: zoom • arraste: mover • clique no ponto: localizar na fila" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#31577B"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              ToolTip="Arraste para ajustar o tamanho do DWG e da fila" />

                <Border Grid.Row="2"
                        Padding="10"
                        Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fila de candidatos"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RecognitionFilterOptions}"
                                      SelectedItem="{Binding SelectedRecognitionFilter}" />
                        </Grid>
                        <DataGrid x:Name="RecognitionCandidatesGrid"
                                  Grid.Row="1"
                                  Margin="0,8,0,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="#091523"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Foreground="{DynamicResource TextBrush}"
                                  RowBackground="#091523"
                                  AlternatingRowBackground="#0D1D30"
                                  ItemsSource="{Binding RecognitionCandidates}"
                                  SelectedItem="{Binding SelectedRecognitionCandidate, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="RecognitionCandidatesGrid_SelectionChanged">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#102641" />
                                    <Setter Property="Foreground" Value="#DCE6F4" />
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="BorderThickness"
                                            Value="0,0,1,1" />
                                    <Setter Property="Padding" Value="7,6" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="82" />
                                <DataGridTextColumn Header="Bloco"
                                                    Binding="{Binding BlockName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Proposta"
                                                    Binding="{Binding Description}"
                                                    Width="1.25*" />
                                <DataGridTextColumn Header="Legenda"
                                                    Binding="{Binding LegendDescription}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="Origem"
                                                    Binding="{Binding RecognitionOrigin}"
                                                    Width="125" />
                                <DataGridTextColumn Header="Conf."
                                                    Binding="{Binding ConfidenceScore}"
                                                    Width="58" />
                                <DataGridTextColumn Header="Posição"
                                                    Binding="{Binding Position}"
                                                    Width="115" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="4"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="14"
                            Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Revisão do candidato"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SelectedRecognitionCandidate.BlockName}"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding SelectedRecognitionCandidate.Handle}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SelectedRecognitionCandidate.Reason}"
                                       TextWrapping="Wrap"
                                       Foreground="#F8C33A"
                                       FontSize="8" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SelectedRecognitionCandidate.LegendDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="#36D17C"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       ToolTip="{Binding SelectedRecognitionCandidate.LegendEvidence}" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding SelectedRecognitionCandidate.RecognitionOrigin}"
                                       Foreground="#63B8FF"
                                       FontSize="8" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding SelectedRecognitionCandidate.StablePath}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="7"
                                       ToolTip="{Binding SelectedRecognitionCandidate.GeometrySignature}" />

                            <TextBlock Margin="0,12,0,4"
                                       Text="Disciplina"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <ComboBox ItemsSource="{Binding RecognitionDisciplineOptions}"
                                      SelectedItem="{Binding RecognitionEditorDiscipline}" />
                            <TextBlock Margin="0,9,0,4"
                                       Text="Código semântico"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBox Text="{Binding RecognitionEditorCode, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,9,0,4"
                                       Text="Descrição"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBox Text="{Binding RecognitionEditorDescription, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,9,0,4"
                                       Text="Layer proposta"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBox Text="{Binding RecognitionEditorLayer, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,9,0,4"
                                       Text="Altura"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBox Text="{Binding RecognitionEditorHeight, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,9,0,4"
                                       Text="Observação"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8" />
                            <TextBox MinHeight="58"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding RecognitionEditorNote, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Margin="0,12,0,0"
                                    Content="Salvar como correção humana"
                                    Command="{Binding SaveRecognitionCorrectionCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Aprovar proposta"
                                        Command="{Binding ApproveRecognitionCandidateCommand}"
                                        CommandParameter="{Binding SelectedRecognitionCandidate}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2"
                                        Content="Rejeitar"
                                        Command="{Binding RejectRecognitionCandidateCommand}"
                                        CommandParameter="{Binding SelectedRecognitionCandidate}"
                                        Style="{DynamicResource SecondaryButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="14"
                            Background="#102B22"
                            BorderBrush="#36D17C"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock Text="Segurança: o inventário e a planta são gerados sobre cópias técnicas. Esta tela não possui comando para gravar no DWG."
                                   TextWrapping="Wrap"
                                   Foreground="#B9F6D3"
                                   FontSize="8" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
