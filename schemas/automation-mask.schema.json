{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Máscara de automação do AutoAIBuilder",
  "description": "Contrato estável 1.0 para descrever uma máscara sem código executável.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "discipline",
    "description",
    "minimumApplicationVersion",
    "acceptedExtensions",
    "requiredRuleIds",
    "dependencies",
    "parameters",
    "outputs",
    "preconditions",
    "postconditions",
    "supportsSimulation",
    "isIdempotent"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "discipline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "minimumApplicationVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "acceptedExtensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "requiredRuleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "supportsSimulation": {
      "type": "boolean"
    },
    "isIdempotent": {
      "type": "boolean"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "extension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9]+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minimumVersion",
        "isRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "minimumVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "isRequired": {
          "type": "boolean"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description",
        "isRequired"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "choice"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "isRequired": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowedValues": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "relativePath",
        "isRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "isRequired": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "isBlocking"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "isBlocking": {
          "type": "boolean"
        }
      }
    }
  }
}
