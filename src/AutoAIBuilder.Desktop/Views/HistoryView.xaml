<UserControl x:Class="AutoAIBuilder.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16"
                Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Histórico"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="{Binding HistorySummary}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Pesquisar eventos"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9"
                           Margin="0,0,0,5" />
                <TextBox Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Pesquisar por ação, descrição, projeto ou categoria"
                         Style="{DynamicResource FieldStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Categoria"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9"
                           Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding HistoryFilterOptions}"
                          SelectedItem="{Binding SelectedHistoryFilter}"
                          Style="{DynamicResource ProjectSelectorStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4"
                Padding="14"
                Style="{DynamicResource CardStyle}">
            <Grid>
                <ListBox ItemsSource="{Binding HistoryEntries}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,7" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="13"
                                    Background="#0A1624"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Date}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding Time}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="9" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Category}"
                                               Foreground="{Binding Accent}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Action}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,16,0"
                                                   Text="{Binding Description}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ProjectName}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="4"
                                            Padding="7,4"
                                            BorderBrush="{Binding Accent}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Accent}"
                                                   FontSize="8" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding EmptyHistoryVisibility}">
                    <TextBlock Text="↶"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontSize="28"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0"
                               Text="Nenhum evento encontrado"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Text="Novas ações importantes aparecerão aqui automaticamente."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
