<UserControl x:Class="AutoAIBuilder.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="16"
                Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnóstico técnico"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding DiagnosticSummary}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding DiagnosticGeneratedAt}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Atualizar diagnóstico"
                        Command="{Binding RefreshDiagnosticsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="14"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ambiente e armazenamento"
                               Style="{DynamicResource SectionTitleStyle}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DiagnosticChecks}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        Background="#0A1624"
                                        BorderBrush="{Binding Accent}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="10" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Value}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Detail}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Text="{Binding Status}"
                                                   Foreground="{Binding Accent}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Execuções operacionais"
                               Style="{DynamicResource SectionTitleStyle}" />
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding OperationExecutions}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="11"
                                            Background="#0A1624"
                                            BorderBrush="{Binding Accent}"
                                            BorderThickness="1,0,0,0"
                                            CornerRadius="5">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           Text="{Binding Status}"
                                                           Foreground="{Binding Accent}"
                                                           FontSize="8"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <ProgressBar Margin="0,7,0,0"
                                                         Height="4"
                                                         Maximum="100"
                                                         Value="{Binding Progress, Mode=OneWay}" />
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="8"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1"
                                                            Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               Foreground="{Binding Accent}"
                                                               FontSize="8"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Time}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="8"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding EmptyOperationExecutionVisibility}">
                            <TextBlock Text="○"
                                       Foreground="#2C9BFF"
                                       FontSize="28"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,9,0,0"
                                       Text="Nenhuma execução registrada"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="O motor está pronto; automações continuam desconectadas."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Padding="14"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Eventos técnicos recentes"
                               Style="{DynamicResource SectionTitleStyle}" />
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding DiagnosticLogs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            Background="#0A1624"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Date}" FontSize="9" />
                                                <TextBlock Text="{Binding Time}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="9" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Level}"
                                                           Foreground="{Binding Accent}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding Source}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Message}"
                                                           FontSize="9"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding Detail}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="8"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding EmptyDiagnosticLogVisibility}">
                            <TextBlock Text="✓"
                                       Foreground="#36D17C"
                                       FontSize="28"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,9,0,0"
                                       Text="Nenhum evento técnico registrado"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
