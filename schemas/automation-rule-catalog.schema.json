{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de regras do AutoAIBuilder",
  "description": "Contrato estável 1.0 para um catálogo versionado de regras de automação.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "version",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogId": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "extension": {
      "type": "string",
      "pattern": "^\\.[A-Za-z0-9]+$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "discipline",
        "severity",
        "description",
        "condition",
        "source",
        "supportedExtensions",
        "isEnabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "discipline": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "information",
            "warning",
            "blocking"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "supportedExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "uniqueItems": true
        },
        "isEnabled": {
          "type": "boolean"
        }
      }
    }
  }
}
