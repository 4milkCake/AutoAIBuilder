<Window x:Class="AutoAIBuilder.Desktop.Views.CadReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoAIBuilder.Desktop.Controls"
        Title="AutoIA Builder — Revisão CAD ampliada"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Revisão CAD ampliada">
    <Window.Resources>
        <Style x:Key="CadToolButtonStyle"
               TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Foreground" Value="#E7EEF8" />
            <Setter Property="Background" Value="#102641" />
            <Setter Property="BorderBrush" Value="#31577B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#173B61" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CadGridStyle"
               TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#203047" />
            <Setter Property="Background" Value="#091523" />
            <Setter Property="BorderBrush" Value="#203047" />
            <Setter Property="Foreground" Value="#E7EEF8" />
            <Setter Property="RowBackground" Value="#091523" />
            <Setter Property="AlternatingRowBackground" Value="#0D1D30" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#102641" />
            <Setter Property="Foreground" Value="#DCE6F4" />
            <Setter Property="BorderBrush" Value="#203047" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="250" MinHeight="150" />
        </Grid.RowDefinitions>

        <Border Padding="15,11"
                Background="#0D1D30"
                BorderBrush="#203047"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Revisão ampliada da planta e dos pontos"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,4,0,0"
                                Orientation="Horizontal">
                        <TextBlock Text="{Binding CadVisualizationSummary}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="9" />
                        <TextBlock Margin="14,0,0,0"
                                   Text="{Binding CadFidelitySummary}"
                                   Foreground="#36D17C"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding SemanticSelectedMapSummary}"
                               Foreground="#F8C33A"
                               FontSize="9"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Content="−"
                            ToolTip="Reduzir zoom"
                            Click="CadZoomOut_Click"
                            Style="{StaticResource CadToolButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Content="+"
                            ToolTip="Ampliar"
                            Click="CadZoomIn_Click"
                            Style="{StaticResource CadToolButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Content="Ajustar aos pontos"
                            ToolTip="Enquadrar a área dos pontos"
                            Click="CadFit_Click"
                            Style="{StaticResource CadToolButtonStyle}" />
                    <Button Margin="5,0,0,0"
                            Content="Mostrar tudo"
                            ToolTip="Mostrar todo o model space"
                            Click="CadFitAll_Click"
                            Style="{StaticResource CadToolButtonStyle}" />
                    <Button Margin="12,0,0,0"
                            Content="Fechar"
                            ToolTip="Fechar a revisão ampliada (Esc)"
                            Click="Close_Click"
                            Style="{StaticResource CadToolButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Border Background="#050E18"
                    BorderBrush="#203047"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <controls:CadViewportControl x:Name="CadViewport"
                                             Snapshot="{Binding CadVisualization}"
                                             OverlayPoints="{Binding CadOverlayPoints}"
                                             Layers="{Binding CadLayers}"
                                             SelectedPointId="{Binding CadSelectedPointId}"
                                             SelectPointCommand="{Binding SelectCadOverlayPointCommand}"
                                             ToolTip="Roda do mouse: zoom • arraste: mover • clique no ponto: revisar" />
            </Border>

            <Border Grid.Column="2"
                    Padding="11"
                    Background="#091523"
                    BorderBrush="#203047"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Camadas do desenho"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                             Height="30"
                             Margin="0,9,0,0"
                             Padding="8,4"
                             Text="{Binding CadLayerSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#E7EEF8"
                             Background="#07111E"
                             BorderBrush="#31577B"
                             ToolTip="Pesquisar layer"
                             AutomationProperties.Name="Pesquisar layer" />
                    <ComboBox Grid.Row="2"
                              Height="30"
                              Margin="0,6,0,0"
                              Padding="6,3"
                              ItemsSource="{Binding CadLayerGroupOptions}"
                              SelectedItem="{Binding SelectedCadLayerGroup}"
                              Foreground="#07111E"
                              ToolTip="Agrupar layers por finalidade"
                              AutomationProperties.Name="Grupo de layers" />
                    <StackPanel Grid.Row="3"
                                Margin="0,6,0,6"
                                Orientation="Horizontal">
                        <Button Content="Mostrar filtradas"
                                Command="{Binding ShowAllCadLayersCommand}"
                                FontSize="8"
                                Style="{StaticResource CadToolButtonStyle}" />
                        <Button Margin="5,0,0,0"
                                Content="Ocultar"
                                Command="{Binding HideAllCadLayersCommand}"
                                FontSize="8"
                                Style="{StaticResource CadToolButtonStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredCadLayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0,0,3"
                                              IsChecked="{Binding IsVisible}"
                                              Content="{Binding Name}"
                                              FontSize="9"
                                              ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#203047"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />

        <Border Grid.Row="4"
                Padding="10"
                Background="#0D1D30"
                BorderBrush="#203047"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pontos identificados"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SemanticFilteredCount}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="8" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Height="30"
                             Padding="8,4"
                             Text="{Binding SemanticSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#E7EEF8"
                             Background="#07111E"
                             BorderBrush="#31577B"
                             ToolTip="Pesquisar ponto"
                             AutomationProperties.Name="Pesquisar ponto" />
                    <ComboBox Grid.Column="3"
                              Height="30"
                              Padding="6,3"
                              ItemsSource="{Binding SemanticFilterOptions}"
                              SelectedItem="{Binding SelectedSemanticFilter}"
                              Foreground="#07111E"
                              AutomationProperties.Name="Filtrar pontos" />
                </Grid>
                <DataGrid x:Name="SemanticPointsGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding SemanticPoints}"
                          SelectedItem="{Binding SelectedSemanticPoint, Mode=TwoWay}"
                          SelectionChanged="SemanticPointsGrid_SelectionChanged"
                          Style="{StaticResource CadGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding ExternalId}"
                                            Width="110" />
                        <DataGridTextColumn Header="Disciplina"
                                            Binding="{Binding Discipline}"
                                            Width="100" />
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Code}"
                                            Width="2*" />
                        <DataGridTextColumn Header="Descrição"
                                            Binding="{Binding Description}"
                                            Width="3*" />
                        <DataGridTextColumn Header="Altura"
                                            Binding="{Binding Height}"
                                            Width="110" />
                        <DataGridTextColumn Header="Estado"
                                            Binding="{Binding ReviewStatus}"
                                            Width="125" />
                        <DataGridTextColumn Header="Coordenadas"
                                            Binding="{Binding Coordinates}"
                                            Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
